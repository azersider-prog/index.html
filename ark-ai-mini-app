<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ark AI Agent Mini App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0d0f12;
            --card-bg: #161a22;
            --gold-primary: #f0b90b;
            --gold-secondary: #d4af37;
            --text-main: #ffffff;
            --text-muted: #848e9c;
            --border-color: #2b313a;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding-bottom: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            width: 100%;
            max-width: 480px;
            padding: 16px;
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--card-bg);
            padding: 14px 16px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            margin-bottom: 16px;
        }
        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .logo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #000;
            font-size: 18px;
            box-shadow: 0 0 12px rgba(240, 185, 11, 0.3);
        }
        .title h1 {
            font-size: 16px;
            font-weight: 700;
        }
        .title span {
            font-size: 12px;
            color: var(--gold-primary);
        }
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .card-title {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        .contract-box {
            background: #090a0d;
            border: 1px solid var(--border-color);
            padding: 10px 12px;
            border-radius: 10px;
            font-family: monospace;
            font-size: 12px;
            color: var(--gold-primary);
            word-break: break-all;
            margin-bottom: 12px;
            text-align: center;
        }
        .btn-gold {
            width: 100%;
            background: linear-gradient(135deg, #f0b90b, #d4af37);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 15px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(240, 185, 11, 0.2);
            transition: 0.2s;
            text-align: center;
            text-decoration: none;
            display: block;
        }
        .btn-gold:active {
            transform: scale(0.98);
        }
        .nav-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #11141b;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 100;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-muted);
            font-size: 11px;
            cursor: pointer;
            text-decoration: none;
            gap: 4px;
        }
        .nav-item.active {
            color: var(--gold-primary);
        }
        .nav-item svg {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }
        .toast {
            position: fixed;
            bottom: 90px;
            background: rgba(0,0,0,0.85);
            color: var(--gold-primary);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            border: 1px solid var(--gold-primary);
            display: none;
            animation: fadeInOut 1.5s ease;
        }
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(10px); }
            50% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- الهيدر -->
        <div class="header">
            <div class="logo-area">
                <div class="logo">ARK</div>
                <div class="title">
                    <h1>Ark AI Agent</h1>
                    <span>شبكة Base</span>
                </div>
            </div>
        </div>

        <!-- بطاقة عقد العملة -->
        <div class="card">
            <div class="card-title">💎 عنوان العقد الرسمى ($ARKAI)</div>
            <div class="contract-box" id="contractText">0x982AD755380a1cFb9CEaF9f3c8E3153E6092BF3F</div>
            <button class="btn-gold" onclick="copyContract()">نسخ العقد</button>
        </div>

        <!-- بطاقة التداول السريع -->
        <div class="card" style="text-align: center;">
            <div class="card-title" style="margin-bottom: 12px;">🚀 المنصة والتداول الفوري</div>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">تداول عملة $ARKAI بأمان وسرعة مباشرة عبر مجمعات السيولة المعتمدة على شبكة Base.</p>
            <a href="https://basescan.org/token/0x982AD755380a1cFb9CEaF9f3c8E3153E6092BF3F" target="_blank" class="btn-gold" style="margin-bottom: 10px;">عرض العقد على Basescan</a>
        </div>
    </div>

    <!-- شريط التنقل السفلي -->
    <div class="nav-bar">
        <a href="#" class="nav-item active">
            <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
            الرئيسية
        </a>
        <a href="https://basescan.org/token/0x982AD755380a1cFb9CEaF9f3c8E3153E6092BF3F" target="_blank" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
            السيولة
        </a>
        <a href="https://t.me/ArkAiAgent_bot" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            المجتمع
        </a>
    </div>

    <div class="toast" id="toast">تم نسخ العقد بنجاح!</div>

    <script>
        function copyContract() {
            const contractText = document.getElementById('contractText').innerText;
            navigator.clipboard.writeText(contractText).then(() => {
                const toast = document.getElementById('toast');
                toast.style.display = 'block';
                setTimeout(() => {
                    toast.style.display = 'none';
                }, 1500);
            });
        }
        
        // تفعيل أدوات تيليجرام WebApp إن وجدت
        if (window.Telegram && window.Telegram.WebApp) {
            window.Telegram.WebApp.ready();
            window.Telegram.WebApp.expand();
        }
    </script>
</body>
</html>
